    users {
        int id PK
        string name
        string email UK
        string password
        string role
        string phone
        string status
    }

    workers {
        int id PK
        int user_id FK
        string trade_title
        int experience_years
        decimal daily_rate
        decimal location_lat
        decimal location_lng
        string verification_status
        decimal rating_avg
    }

    contractors {
        int id PK
        int user_id FK
        string company_name
        string license_no
        string city
        decimal rating_avg
    }

    clients {
        int id PK
        int user_id FK
        string company_name
        string client_type
        string city
    }

    projects {
        int id PK
        int contractor_id FK
        int client_id FK
        string title
        string location
        decimal location_lat
        decimal location_lng
        decimal budget
        string status
        int progress_percent
        string qr_code_token UK
    }

    jobs {
        int id PK
        int project_id FK
        int contractor_id FK
        string title
        string trade_required
        decimal pay_rate
        string status
    }

    job_applications {
        int id PK
        int job_id FK
        int worker_id FK
        int match_score
        string status
    }

    attendance {
        int id PK
        int project_id FK
        int worker_id FK
        date attendance_date
        datetime check_in_time
        datetime check_out_time
        tinyint verified_by_qr
        string status
    }

    contracts {
        int id PK
        int project_id FK
        int contractor_id FK
        int worker_id FK
        string contract_number UK
        decimal payment_amount
        string status
    }

    bookings {
        int id PK
        string booking_number UK
        int client_id FK
        int provider_id FK
        string booking_mode
        string category
        string title
        decimal location_lat
        decimal location_lng
        decimal price
        string status
    }

    booking_quotes {
        int id PK
        int booking_id FK
        int provider_id FK
        string provider_role
        decimal proposed_price
        string estimated_duration
        string status
    }
